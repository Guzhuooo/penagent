# 设备 profile：有道词典笔 Y02 / 固件 4.9.7
# 设备参数依据：DEVICE_PROFILE.md；能力验收状态依据 docs/STANDARDS.md
# 网络、输入法全生命周期、exec deadline/cancel 尚待本项目完整验收
# 用法：构建脚本 source 本文件；禁止在源码里硬编码这些值

PROFILE_ID=y02-4.9.7
DEVICE_SERIAL=<device-serial>
DEVICE_HOSTNAME=YoudaoDictionaryPen-093

# ---- 身份 ----
DEVICE_MODEL=Y02
DEVICE_CODENAME=Y02-3562
DEVICE_SOC="Rockchip RK3562"
DEVICE_FIRMWARE=4.9.7
DEVICE_FIRMWARE_BUILD="Thu Nov 13 16:16:03 CST 2025"
DEVICE_OS="Buildroot 2021.11"
DEVICE_KERNEL=5.10.160

# ---- ABI ----
ABI_ARCH=aarch64
ABI_BITS=64
ABI_ELF_MACHINE=183          # EM_AARCH64
ABI_ENDIAN=little
ABI_LIBC=glibc
ABI_LIBSTDCXX=6.0.29
ABI_CROSS_TOOLCHAIN=github-actions-only # native 编译/链接仅允许批准的 CI 工具链

# ---- 屏幕 ----
# 逻辑屏（UI 坐标系），来自 /etc/miniapp/resources/cfg.json
SCREEN_LOGICAL_WIDTH=936
SCREEN_LOGICAL_HEIGHT=280
SCREEN_DIRECTION=270
SCREEN_XOFFSET=0
SCREEN_YOFFSET=0
# 物理面板，来自 modetest
SCREEN_PHYSICAL_WIDTH=280
SCREEN_PHYSICAL_HEIGHT=936
SCREEN_REFRESH_HZ=60.14
SCREEN_CONNECTOR=DSI-1
SCREEN_CRTC=0
SCREEN_DRM_DRIVER=rockchip-vop2
# 截图实测
SCREEN_CAPTURE_WIDTH=936
SCREEN_CAPTURE_HEIGHT=280

# ---- 触控 ----
TOUCH_DEVICE=/dev/input/by-path/sitronix_ts_spi
TOUCH_DIRECTION=270
TOUCH_XOFFSET=0
TOUCH_YOFFSET=0

# ---- vw/vh（DEVICE_* 的 Y02 历史校准，非完整 M0 验收）----
# 历史测量：100vw = 936 逻辑px，100vh = 280 逻辑px，误差 <= 1px
# 仅作设备换算证据，不作通用布局 token；本次未视觉复核，未验多分辨率
VW_SUPPORTED=true
VH_SUPPORTED=true
VW_UNIT_PX=9.36
VH_UNIT_PX=2.80
VW_VH_INDEPENDENT=true       # vh 按视口高度推导，非与 vw 同比例
DESIGN_WIDTH=936             # 传给 setViewPort()
DESIGN_HEIGHT=280

# ---- 运行时 ----
FALCON_RENDERER=/usr/lib/libfalcon.so
FALCON_QUICKJS=/usr/lib/libquickjs.so
QUICKJS_VERSION=20200705
JS_FRAMEWORK_VERSION=0.0.32
VUE_VERSION=2.6.12
RUNTIME_BIN=/usr/bin/miniapp

# ---- 媒体 ----
GSTREAMER_VERSION=1.22.0
GST_DECODER=mppvideodec
GST_SINK=kmssink
FFMPEG=/usr/bin/ffmpeg
FFMPEG_DECODERS="h264 hevc aac mp3"
FBDEV_PRESENT=false          # 无 /dev/fb0，禁用一切写帧缓冲的方案

# ---- 包 ----
# app/package.json 是 appid/version 唯一来源；这里不复制发布身份。
START_PAGE=index
# AMR 仅由 app/package.json 的 aiot-cli scripts 构建，不使用通用 ZIP 打包。
INSTALL_ROOT=/userdisk/secondary/miniapp/data/mini_app/pkg
LOG_DIR=/userdata/applog

# ---- 系统小程序 ----
IM_APPID=8001666679481944        # 有道输入法
IM_CATEGORY=Youdao_IM
PLAYER_APPID=8001650599023931    # 播放器
DESKTOP_APPID=8080222437664451   # 桌面

# ---- 网络 ----
NET_IFACE=wlan0
# endpoint 与凭据来自用户设置，生产默认留空。

# ---- CLI ----
# 注意：page 参数不能带 -- 前缀
CLI_INSTALL="miniapp_cli install {amr}"
CLI_START="miniapp_cli start {appid} {page}"
CLI_CAPTURE="miniapp_cli capture {path}"
# captureFB 在本设备返回 ret=-1，不可用
